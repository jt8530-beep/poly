# --- LP Market Maker config ---
# All values have sensible defaults; override only what you need.
#
# IMPORTANT: keep comments on their OWN line (start with #), not after a
# value on the same line. systemd / docker --env-file consumers don't strip
# inline comments. The config loader strips them defensively, but other
# tools won't.

# --- Endpoints ---
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_CLOB_URL=https://clob.polymarket.com

# --- HTTP behaviour ---
LP_HTTP_TIMEOUT=15
LP_HTTP_SLEEP=0.20
LP_HTTP_RETRIES=4
LP_USER_AGENT=lp-market-maker/0.1

# --- Scanner pagination ---
# 100 events/page * 15 pages = 1500 most-recent events scanned
LP_EVENTS_MAX_PAGES=15
LP_EVENTS_PAGE=100

# --- v2.1 LESSONS (2026-05-26 PLTR loss + post-deploy review):
#   1. Equity-derivative markets have inventory-volatility-driven spreads
#      that look like sparse competition but are really risk premium.
#   2. Traditional sports half-time still has heavy public re-evaluation
#      (NBA/NFL/MLB/Soccer) — only esports digital game state is truly paused.
#   3. 'Games' tag was on BOTH esports and trad sports — defeats whitelist.
# See POSTMORTEM.md.

# Tags whose presence flag a market as inventory-volatility-driven —
# rejected even if reward pool is huge.
LP_BLACKLIST_TAGS=Finance,Stocks,Equity,ETF,ETFs,Macro,Crypto Prices,Hit Price,Politics,Election,Elections,FX,Forex,Bonds,Commodities,Energy,Interest Rates,MLB,NHL,NBA,NFL,Soccer,Tennis,Cricket,Football,Baseball,Hockey,Premier League,La Liga,Bundesliga,Serie A,Ligue 1,Champions League

# Strict: ONLY events with one of these tags pass. 'Games' deliberately
# removed (it tags both esports AND trad sports). 'Sports' removed
# (tags everything).
LP_WHITELIST_TAGS=Esports,Weather

# Hard skip events with volume above this $ (0 = no cap)
# High-volume events have pro market makers — recommend cap at 1M for dead-zone plays
LP_MAX_EVENT_VOLUME=0

# --- Reward pool floor ---
# Skip markets with daily rate below this (dust)
LP_MIN_DAILY_RATE=30

# --- Mid-price guardrails ---
# Skip markets in extreme tails — adverse-selection risk skyrockets there
LP_MIN_MID=0.005
LP_MAX_MID=0.95

# --- Time horizon ---
# Don't deploy on markets resolving in less than this
LP_MIN_HOURS=1
# But also don't deploy on infinite-horizon markets (capital efficiency)
LP_MAX_DAYS=365

# --- Order suggestion params ---
# Place suggested bid/ask this fraction of rewardsMaxSpread inside the band
LP_INSIDE_BAND=0.9
# Multiplier on rewardsMinSize for suggested order size
LP_SIZE_MULT=1.0

# --- Competition capture heuristics ---
# If observed spread > N × max_reward_spread → sparse competition
LP_SPARSE_MULT=3.0
# Estimated reward share when we're (effectively) alone vs competitive
LP_CAPTURE_ALONE=0.7
LP_CAPTURE_COMPETITIVE=0.15

# --- Output ---
LP_TOP_N=20

# --- Misc ---
LP_DATA_DIR=data
LP_LOG_LEVEL=INFO
