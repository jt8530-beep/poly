# --- Wallet Alpha Radar config ---
# All values have sensible defaults; override only what you need.
#
# IMPORTANT: place comments on their own line (start with #), NOT after a
# value on the same line. systemd's EnvironmentFile passes the entire line
# after `=` to the process, including any trailing comment. The config
# loader does strip `# ...` defensively, but other tools (docker --env-file,
# kube secrets, etc.) won't, so keep comments above the variable.

# --- Endpoints (don't change unless Polymarket moves them) ---
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_CLOB_URL=https://clob.polymarket.com
# POLY_DATA_URL=https://data-api.polymarket.com
# POLY_LB_URL=https://lb-api.polymarket.com

# --- HTTP behaviour ---
WAR_HTTP_TIMEOUT=15
WAR_HTTP_SLEEP=0.30
WAR_HTTP_RETRIES=4
WAR_USER_AGENT=wallet-alpha-radar/0.1

# --- Discovery (script 01) ---
WAR_LB_METRIC=profit
WAR_LB_SKIP_TOP=20
WAR_LB_TAKE=200
# Set to 1 to also enumerate recently-closed markets.
WAR_DISCOVER_WINNERS=0
WAR_WINNER_LOOKBACK_DAYS=30
WAR_WINNER_MIN_VOLUME=5000

# --- History (script 02) ---
WAR_TRADES_PAGE=500
WAR_TRADES_CAP=5000
# Set to 1 to skip wallets already in history (faster re-runs).
WAR_HISTORY_SKIP_EXISTING=0
WAR_MARKET_CACHE_SEC=86400

# --- Scoring (script 03) — hard filters ---
WAR_MIN_SETTLED=50
WAR_MIN_ACTIVE_DAYS=30
WAR_MIN_VOLUME=3000
WAR_MAX_HEDGE=0.20
WAR_MAX_CONC=0.35
WAR_MAX_090_RATIO=0.30

# --- Scoring — soft + tier cutoffs ---
WAR_ENTRY_MID_LO=0.35
WAR_ENTRY_MID_HI=0.65
WAR_TIER_A_MIN=50
WAR_TIER_B_MIN=38

# --- Orderbook recorder (script 04, long-running) ---
WAR_WATCHLIST=data/orderbook_watchlist.txt
WAR_SNAPSHOT_DIR=data/orderbook
WAR_OB_INTERVAL=30
WAR_OB_BATCH=50
WAR_OB_ROTATE_DAILY=1

# --- Wallet-trade tail recorder (script 05, long-running) ---
WAR_TT_SCORES=data/wallet_scores.csv
WAR_TT_OUTPUT=data/wallet_trades_tail.csv
# Comma-separated tier list, e.g. A or A,B
WAR_TT_TIERS=A
# Seconds between polls per wallet
WAR_TT_INTERVAL=60
# How many recent trades to ask per poll
WAR_TT_FETCH_LIMIT=100

# --- Phase 2 backtest (script 06, offline) ---
# Trade source: tail | history | both
WAR_BT_SOURCE=both
WAR_BT_TIERS=A
# T+delta seconds to simulate
WAR_BT_DELAYS=60,300,1800
# Follow-fill must be <= wallet_entry + WAR_BT_MAX_SLIP
WAR_BT_MAX_SLIP=0.03
# Ignore as not_copyable if spread is wider than this
WAR_BT_MAX_SPREAD=0.05
# Require >= this $ depth on the ask
WAR_BT_MIN_DEPTH=30
# Snapshot gap tolerance (seconds)
WAR_BT_MAX_GAP=90

# --- Misc ---
WAR_DATA_DIR=data
WAR_LOG_LEVEL=INFO
