# BTC5m S5 + trend + tail60 strategy

# Trend gate
BTC5M_TREND_GATE_ENABLED=1
BTC5M_TREND_LOOKBACK_MIN=2
BTC5M_TREND_THRESHOLD_BPS=0

# S5 layered direction filter
BTC5M_LOW_EDGE_CONFIRM_MAX_BPS=1000
BTC5M_LOW_EDGE_MIN_DIRECTION_BPS=4
BTC5M_HIGH_EDGE_MIN_DIRECTION_BPS=2

# Entry gate
BTC5M_MIN_SECONDS_AFTER_START=90
BTC5M_MIN_SECONDS_BEFORE_END=90
BTC5M_MAX_OPEN_POSITIONS=1
BTC5M_MIN_EDGE_BPS=800
BTC5M_MAX_SPREAD_PCT=0.03
BTC5M_MAX_ENTRY_PRICE=0.82
BTC5M_MIN_ASK_DEPTH_SHARES=10
BTC5M_ENTRY_EXITABILITY_MAX_SPREAD_PCT=1.0
BTC5M_ENTRY_EXITABILITY_MIN_ASK_DEPTH_SHARES=0
BTC5M_MAX_NOTIONAL_USD=10
BTC5M_MIN_NOTIONAL_USD=5

# Fair-prob model
BTC5M_VOL_LOOKBACK_MIN=120
BTC5M_MIN_VOL_1M=0.00035

# Exits
BTC5M_TAIL_FORCE_EXIT_SEC=60
BTC5M_TAKE_PROFIT=999
BTC5M_PRE_SETTLE_LOSS_CAP_ENABLED=0
BTC5M_PRE_SETTLE_EXIT1_SEC=150
BTC5M_PRE_SETTLE_EXIT1_MAX_LOSS=0.60
BTC5M_PRE_SETTLE_EXIT2_SEC=120
BTC5M_PRE_SETTLE_EXIT2_MAX_LOSS=0.50
BTC5M_PRE_SETTLE_EXIT3_SEC=90
BTC5M_PRE_SETTLE_EXIT3_MAX_LOSS=0.40
BTC5M_PRE_SETTLE_EXIT4_SEC=60
BTC5M_PRE_SETTLE_EXIT4_MAX_LOSS=0.30
BTC5M_PRE_SETTLE_EXIT5_SEC=30
BTC5M_PRE_SETTLE_EXIT5_MAX_LOSS=0.20
BTC5M_PRE_SETTLE_EXIT6_SEC=10
BTC5M_PRE_SETTLE_EXIT6_MAX_LOSS=0.00
BTC5M_STOP_LOSS_ENABLED=1
BTC5M_STOP_LOSS=0.30

# Optional overlay
BTC5M_DISASTER_TRAIL_ENABLED=1
BTC5M_TRAIL_ACTIVATE_PROFIT=0.80
BTC5M_TRAIL_MIN_SECONDS_LEFT=120
BTC5M_TRAIL_GIVEBACK=0.20

# Settlement / runtime
BTC5M_SETTLE_DELAY_SEC=8
BTC5M_INTERVAL_SEC=10
