# --- Overround Arb Scanner config ---
# All values have sensible defaults; override only what you need.
#
# IMPORTANT: keep comments on their OWN line (start with #), not after a
# value on the same line. systemd/docker --env-file consumers don't strip
# inline comments. The config loader strips them defensively, but other
# tools won't.

# --- Endpoints (don't change unless Polymarket moves them) ---
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_CLOB_URL=https://clob.polymarket.com

# --- HTTP behaviour ---
OA_HTTP_TIMEOUT=15
OA_HTTP_SLEEP=0.20
OA_HTTP_RETRIES=4
OA_USER_AGENT=overround-arb/0.1

# --- Event-level filters ---
# Need at least this many active markets to even be a "basket"
OA_MIN_OUTCOMES=5
# Event lifetime $ volume floor — filters dust events
OA_MIN_VOLUME=50000
# Settlement horizon must be in this window (days)
OA_DAYS_END_MIN=1
OA_DAYS_END_MAX=730

# --- Market-level filters (within each event) ---
# Exclude eliminated / no-liquidity placeholders (asks at 1.0 are often stale)
OA_MAX_MARKET_ASK=0.99
# Optional positive floor for "real" liquidity (0 = any positive ask)
OA_MIN_MARKET_ASK=0.0

# --- Opportunity classification thresholds ---
# Pure arb if total_ask is below this
OA_ARB_MAX=1.00
# Near-arb if below this
OA_NEAR_ARB_MAX=1.05
# Premium-harvest if below this AND days_to_end >= OA_PREMIUM_MIN_DAYS
OA_PREMIUM_MAX=1.20
OA_PREMIUM_MIN_DAYS=30

# --- Sanity range — totals outside this are flagged 'anomalous' ---
# Likely a contaminated event with non-mutually-exclusive prop markets
OA_SANITY_MIN=0.50
OA_SANITY_MAX=1.50

# --- Scanner pagination ---
# 100 events per page * 20 pages = 2000 most recent open events scanned
OA_EVENTS_PAGE=100
OA_EVENTS_MAX_PAGES=20

# --- Output ---
# Set to 1 to also append every scan to data/scan_history.csv (cron mode)
# OA_APPEND_HISTORY=1

# ============================================================
# Paper trader (script 07, long-running)
# ============================================================

# --- Position sizing ---
# Simulated $ per basket position
OA_PT_BUDGET=100
# Concurrent open-position cap
OA_PT_MAX_POSITIONS=50

# --- Entry filter (which scanner classifications to act on) ---
OA_PT_CLASSES=arb,near_arb,premium_harvest
# Stricter than scanner default — paper trader avoids dust
OA_PT_MIN_VOLUME=100000
# Refuse to enter if live total_ask exceeds this even when scanner said premium_harvest
OA_PT_MAX_ENTRY_ASK=1.10
# Settlement horizon (days)
OA_PT_MIN_DAYS=3
OA_PT_MAX_DAYS=365

# --- Exit policy (per-position, evaluated each cycle) ---
# Take profit on MtM = basket_units * total_bid
OA_PT_TP=0.10
# Stop loss when MtM_bid drops this far below cost
OA_PT_SL=0.20
# Disable stop loss for pure-arb positions (they have positive edge to settlement)
OA_PT_NO_SL_ON_ARB=1
# Force-close at MtM bid this many days before settlement (0 = always wait)
OA_PT_FORCE_CLOSE_DAYS=0

# --- Loop cadence ---
# Refresh every 10 minutes
OA_PT_INTERVAL=600

# --- Output paths ---
OA_PT_POSITIONS=data/paper_positions.csv
OA_PT_LEGS=data/paper_position_legs.csv
OA_PT_CLOSED=data/paper_trades_closed.csv
OA_PT_SNAPSHOTS=data/paper_position_mtm.jsonl
# Where the paper trader reads candidates from (output of 01_scan_events.py)
OA_PT_OPPS=data/overround_opportunities.csv

# --- Misc ---
OA_DATA_DIR=data
OA_LOG_LEVEL=INFO
